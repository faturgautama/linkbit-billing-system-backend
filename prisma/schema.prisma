// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model user {
    id_user            Int                 @id @default(autoincrement())
    user_group         user_group          @relation(references: [id_user_group], fields: [id_user_group])
    id_user_group      Int
    setting_company    setting_company     @relation(references: [id_setting_company], fields: [id_setting_company])
    id_setting_company Int
    username           String              @unique
    password           String
    full_name          String
    email              String?
    address            String?
    phone              String?
    whatsapp           String?
    notes              String?
    is_active          Boolean             @default(true)
    create_at          DateTime            @default(now())
    create_by          Int
    update_at          DateTime?
    update_by          Int?
    last_login         DateTime?
    last_logout        DateTime?
    log_activity_user  log_activity_user[]
}

model user_group {
    id_user_group   Int               @id @default(autoincrement())
    user_group      String
    is_active       Boolean           @default(true)
    create_at       DateTime          @default(now())
    create_by       Int
    update_at       DateTime?
    update_by       Int?
    user            user[]
    user_group_menu user_group_menu[]
}

model menu {
    id_menu         Int               @id @default(autoincrement())
    menu            String
    icon            String
    url             String
    id_parent       Int?
    is_active       Boolean           @default(true)
    create_at       DateTime          @default(now())
    create_by       Int
    update_at       DateTime?
    update_by       Int?
    user_group_menu user_group_menu[]
}

model user_group_menu {
    id_user_group_menu Int        @id @default(autoincrement())
    user_group         user_group @relation(references: [id_user_group], fields: [id_user_group])
    id_user_group      Int
    menu               menu       @relation(references: [id_menu], fields: [id_menu])
    id_menu            Int
}

model setting_company {
    id_setting_company       Int                        @id @default(autoincrement())
    company_name             String
    company_email            String
    company_short_name       String
    company_address          String
    company_phone            String
    company_whatsapp         String
    company_email_admin      String
    company_nomor_rekening   String
    company_bank_name        String
    tagihan_ppn              Int
    tagihan_jatuh_tempo      Int
    tagihan_use_unik_kode    Boolean
    tagihan_biaya_admin      Float
    tagihan_pesan_invoice    String
    tagihan_pesan_lunas      String
    tagihan_editor_invoice   String
    tagihan_editor_pos       String
    create_at                DateTime
    create_by                Int
    update_at                DateTime?
    update_by                Int?
    is_active                Boolean                    @default(true)
    is_mitra                 Boolean                    @default(false)
    is_cabang                Boolean                    @default(false)
    api_key_pg               String?
    is_use_pg_admin_fee      Boolean?                   @default(false)
    api_key_wa               String?
    pelanggan                pelanggan[]
    user                     user[]
    log_whatsapp_message     log_whatsapp_message[]
    tagihan_kso              tagihan_kso[]
    history_import_pelanggan history_import_pelanggan[]
    product                  product[]
    payment_method_manual    payment_method_manual[]
    setting_channel_whatsapp setting_channel_whatsapp[]
}

model payment_method_manual {
    id_payment_method_manual Int             @id @default(autoincrement())
    setting_company          setting_company @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company       Int
    payment_method           String
    no_rekening              String?
    create_at                DateTime
    create_by                Int
    update_at                DateTime?
    update_by                Int?
    is_active                Boolean         @default(true)
}

model channel_whatsapp {
    id_channel_whatsapp      Int                        @id @default(autoincrement())
    channel_whatsapp         String
    api_url                  String
    required_credential      Json?
    create_at                DateTime
    create_by                Int
    update_at                DateTime?
    update_by                Int?
    is_active                Boolean                    @default(true)
    setting_channel_whatsapp setting_channel_whatsapp[]
}

model setting_channel_whatsapp {
    id_setting_channel_whatsapp Int              @id @default(autoincrement())
    channel_whatsapp            channel_whatsapp @relation(fields: [id_channel_whatsapp], references: [id_channel_whatsapp])
    id_channel_whatsapp         Int
    setting_company             setting_company  @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company          Int
    credential                  Json?
    create_at                   DateTime
    create_by                   Int
    update_at                   DateTime?
    update_by                   Int?
    is_default                  Boolean          @default(false)
    is_active                   Boolean          @default(true)
}

model product {
    id_product               Int                 @id @default(autoincrement())
    product_name             String
    description              String
    price                    Float
    invoice_cycle            String
    days_before_send_invoice Int
    is_active                Boolean             @default(true)
    create_at                DateTime            @default(now())
    create_by                Int
    update_at                DateTime?
    update_by                Int?
    pelanggan_product        pelanggan_product[]
    invoice                  invoice[]
    payment                  payment[]
    setting_company          setting_company     @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company       Int
}

model group_pelanggan {
    id_group_pelanggan       Int                        @id @default(autoincrement())
    id_setting_company       Int
    group_pelanggan          String
    is_active                Boolean                    @default(true)
    create_at                DateTime                   @default(now())
    create_by                Int
    update_at                DateTime?
    update_by                Int?
    pelanggan                pelanggan[]
    history_import_pelanggan history_import_pelanggan[]
}

model pelanggan {
    id_pelanggan         Int                 @id @default(autoincrement())
    setting_company      setting_company     @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company   Int
    group_pelanggan      group_pelanggan     @relation(fields: [id_group_pelanggan], references: [id_group_pelanggan])
    id_group_pelanggan   Int
    full_name            String
    pelanggan_code       String
    identity_number      String?
    email                String?
    password             String?
    alamat               String?
    phone                String
    whatsapp             String?
    subscribe_start_date DateTime?
    pic_name             String?
    notes                String?
    is_active            Boolean             @default(true)
    create_at            DateTime            @default(now())
    create_by            Int
    update_at            DateTime?
    update_by            Int?
    pelanggan_product    pelanggan_product[]
    invoice              invoice[]
    payment              payment[]
}

model pelanggan_product {
    id_pelanggan_product     Int       @id @default(autoincrement())
    pelanggan                pelanggan @relation(fields: [id_pelanggan], references: [id_pelanggan])
    id_pelanggan             Int
    product                  product   @relation(fields: [id_product], references: [id_product])
    id_product               Int
    start_date               DateTime
    price                    Float
    invoice_cycle            String
    days_before_send_invoice Int
    expired_date             DateTime?
    is_active                Boolean   @default(true)
    create_at                DateTime  @default(now())
    create_by                Int
    update_at                DateTime?
    update_by                Int?
    invoice                  invoice[]
}

model invoice {
    id_invoice           Int                    @id @default(autoincrement())
    invoice_number       String
    invoice_date         DateTime
    pelanggan            pelanggan              @relation(fields: [id_pelanggan], references: [id_pelanggan])
    id_pelanggan         Int
    pelanggan_product    pelanggan_product      @relation(fields: [id_pelanggan_product], references: [id_pelanggan_product])
    id_pelanggan_product Int
    product              product                @relation(fields: [id_product], references: [id_product])
    id_product           Int
    price                Float
    diskon_percentage    Float
    diskon_rupiah        Float
    pajak                Int
    admin_fee            Float
    unique_code          String
    total                Float
    due_date             DateTime
    notes                String?
    invoice_status       String                 @default("PENDING")
    create_at            DateTime               @default(now())
    create_by            Int
    update_at            DateTime?
    update_by            Int?
    is_deleted           Boolean                @default(false)
    delete_at            DateTime?
    delete_by            Int?
    payment              payment[]
    log_whatsapp_message log_whatsapp_message[]
}

model payment {
    id_payment       Int       @id @default(autoincrement())
    invoice          invoice   @relation(fields: [id_invoice], references: [id_invoice])
    id_invoice       Int
    pelanggan        pelanggan @relation(fields: [id_pelanggan], references: [id_pelanggan])
    id_pelanggan     Int
    product          product   @relation(fields: [id_product], references: [id_product])
    id_product       Int
    payment_token    String
    payment_id       String
    payment_number   String
    payment_date     DateTime
    payment_method   String
    payment_status   String
    payment_amount   Float
    payment_provider String
    expired_at       DateTime?
    create_at        DateTime  @default(now())
    create_by        Int
    update_at        DateTime?
    update_by        Int?
}

model tagihan_kso {
    id_tagihan_kso     Int             @id @default(autoincrement())
    no_tagihan_kso     String
    periode            DateTime
    setting_company    setting_company @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company Int
    jumlah_pelanggan   Int             @default(0)
    jumlah_pemasukan   Float           @default(0)
    total_bhp_uso      Float           @default(0)
    total_pph_final    Float           @default(0)
    total_kso          Float           @default(0)
    total_tagihan      Float           @default(0)
    status_bayar       String          @default("PENDING")
    create_at          DateTime        @default(now())
    create_by          Int
    update_at          DateTime?
    update_by          Int?
}

model log_whatsapp_message {
    id_log_whatsapp_message Int             @id @default(autoincrement())
    invoice                 invoice         @relation(fields: [id_invoice], references: [id_invoice])
    id_invoice              Int
    setting_company         setting_company @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company      Int
    additional_info         Json?
    sent_at                 DateTime
    sent_by                 Int
    resent_at               DateTime?
    resent_by               Int?
    type                    String?         @default("INVOICE")
    status                  String          @default("SUCCESS")
}

model history_import_pelanggan {
    id_history           Int             @id @default(autoincrement())
    id_pelanggan         Int
    setting_company      setting_company @relation(fields: [id_setting_company], references: [id_setting_company])
    id_setting_company   Int
    group_pelanggan      group_pelanggan @relation(fields: [id_group_pelanggan], references: [id_group_pelanggan])
    id_group_pelanggan   Int
    full_name            String
    pelanggan_code       String
    identity_number      String?
    email                String?
    password             String?
    alamat               String?
    phone                String
    whatsapp             String?
    subscribe_start_date DateTime?
    pic_name             String?
    notes                String?
    is_active            Boolean         @default(true)
    create_at            DateTime        @default(now())
    create_by            Int
}

model template_editor {
    id_template_editor      Int       @id @default(autoincrement())
    template_pesan_invoice  String
    template_pesan_lunas    String
    template_editor_invoice String
    template_editor_pos     String
    create_at               DateTime  @default(now())
    create_by               Int
    update_at               DateTime?
    update_by               Int?
}

model log_activity_user {
    id_log_activity_user Int      @id @default(autoincrement())
    user                 user     @relation(fields: [id_user], references: [id_user])
    id_user              Int
    endpoint             String
    method               String
    request_body         Json?
    ip_address           String
    browser              String
    create_at            DateTime @default(now())
}

model xendit_payment_method {
    id_xendit_payment_method Int     @id @default(autoincrement())
    payment_method_type      String
    payment_method_name      String
    payment_method_code      String
    payment_method_fee       Decimal
    is_active                Boolean @default(false)
}
